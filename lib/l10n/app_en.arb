  "audioBitrateLabel": "Audio bitrate",
  "@audioBitrateLabel": {"description": "Label für das Audio-Bitrate-Dropdown"},

  "silent": "Silent",
  "@silent": {"description": "Audio-Bitrate-Eintrag für kein Audio"},

  "audioBitrateInfoContent": "Silent   → no audio\n64 kbps  → voice, podcasts\n96 kbps  → good voice quality\n128 kbps → standard music\n192 kbps → high audio quality\n320 kbps → maximum MP3 quality",
  "@audioBitrateInfoContent": {"description": "Inhalt des Audio-Bitrate-Info-Dialogs"},

  "audioCodecLabel": "Audio codec",
  "@audioCodecLabel": {"description": "Label für die Audio-Codec-Auswahl"},

  "expertVideoCodecInfoContent": "H.264 → best compatibility and usually faster\nH.265 → smaller files at comparable quality, slower\nVP9 → efficient open codec for WebM and MKV, slower software encoding\nAV1 → best compression, software-only encoding, experimental\nXvid → legacy MPEG-4 codec for AVI and older players\n\nThe output formats below are enabled according to the selected video and audio codecs.",
  "@expertVideoCodecInfoContent": {"description": "Erklärung der Video-Codecs im Expertenmodus"},

  "xvidLegacyLabel": "Xvid (Legacy)",
  "@xvidLegacyLabel": {"description": "Label des Xvid-Codecs im Expertenmodus"},

  "av1SlowHint": "AV1 is encoded in software only and is much slower than H.264/H.265.",
  "@av1SlowHint": {"description": "Warnhinweis zur Encoding-Dauer von AV1"},

  "av1HighResHint": "Above 720p it is worth scaling down first.",
  "@av1HighResHint": {"description": "Zusatzhinweis für AV1 oberhalb von 1080p"},

  "av1ExperimentalTitle": "AV1 (experimental)",
  "@av1ExperimentalTitle": {"description": "Titel des experimentellen AV1-Schalters in den App-Einstellungen"},

  "av1ExperimentalSubtitle": "Adds AV1 to the codec selection in normal and expert mode. Modern codec with strong compression, not yet fully tested.",
  "@av1ExperimentalSubtitle": {"description": "Untertitel des experimentellen AV1-Schalters"},

  "audioCodecInfoContent": "AAC → standard for MP4, best compatibility\nMP3 → widely used legacy codec\nOpus → modern and efficient, ideal for WebM and MKV\nAC3 → Dolby Digital, shown only for surround sources (≥ 3 channels)\nVorbis → open codec for WebM and MKV\n\nIncompatible output formats are disabled automatically.",
  "@audioCodecInfoContent": {"description": "Inhalt des Audio-Codec-Info-Dialogs"},

  "outputFormatLabel": "Output format",
  "@outputFormatLabel": {"description": "Label für die Output-Format-Auswahl"},

  "outputFormatInfoContent": "MP4 → universal, best compatibility\nMKV → flexible container for all offered codecs\nMOV → Apple/QuickTime workflows\nAVI → legacy format using Xvid\nMPEG-TS → TV and streaming transport stream\nWebM → modern web format using VP9 with Opus or Vorbis\n\nIncompatible formats appear dimmed. Selecting one automatically applies its default video codec and, if needed, a compatible audio codec.",
  "@outputFormatInfoContent": {"description": "Inhalt des Output-Format-Info-Dialogs"},

