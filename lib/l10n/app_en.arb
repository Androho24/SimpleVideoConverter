  "@fpsInfoTitle": {"description": "Titel des FPS-Info-Dialogs"},

  "fpsInfoContent": "Orig  → Keep source video FPS\n24    → Cinema standard\n25    → PAL/TV standard (Europe)\n30    → NTSC/TV, social media\n60    → Smooth, gaming, sports",
