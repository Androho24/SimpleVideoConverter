  "crfLabel": "Video quality (CRF)",
  "@crfLabel": {"description": "Label für den CRF-Dropdown"},

  "crfInfoTitle": "CRF — Video quality",
  "@crfInfoTitle": {"description": "Titel des CRF-Info-Dialogs"},

  "crfInfoContent": "0 → lossless (very large file)\n18 → visually nearly lossless\n23 → standard (good balance)\n28 → visible quality loss\n51 → lowest quality\n\nRecommended: 18–28",
  "@crfInfoContent": {"description": "Inhalt des CRF-Info-Dialogs"},

  "crfInfoContentWideScale": "0 → lossless (very large file)\n25 → visually nearly lossless\n30 → standard (good balance)\n38 → visible quality loss\n63 → lowest quality\n\nRecommended: 25–38\n\nVP9 and AV1 use a 0–63 scale: the same number means a different quality than with H.264/H.265.",
  "@crfInfoContentWideScale": {"description": "CRF-Erklärung für die 0–63-Skala von VP9 und AV1"},

